rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions for common validations
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isProjectOwner(projectId) {
      let projectDoc = get(/databases/{database}/documents/projects/{projectId});
      return projectDoc.exists && projectDoc.data.owner_uid == request.auth.uid;
    }

    function isProjectCollaborator(projectId) {
      let projectDoc = get(/databases/{database}/documents/projects/{projectId});
      return projectDoc.exists && 
             (request.auth.uid in projectDoc.data.collaborators || 
              projectDoc.data.owner_uid == request.auth.uid);
    }

    function isProjectPublic(projectId) {
      let projectDoc = get(/databases/{database}/documents/projects/{projectId});
      return projectDoc.exists && projectDoc.data.is_public == true;
    }

    // ==================== User Collection ====================
    match /user/{uid} {
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow read: if isUser(uid) || isAuthenticated();
      allow write: if isUser(uid);
      allow delete: if isUser(uid);

      // Validate user data on write
      allow write: if request.resource.data.keys().hasAll(['email', 'uid']) &&
                      request.resource.data.uid == uid;
    }

    // ==================== Projects Collection ====================
    match /projects/{projectId} {
      // Create: authenticated user can create
      allow create: if isAuthenticated() &&
                       request.resource.data.owner_uid == request.auth.uid &&
                       request.resource.data.keys().hasAll(['name', 'owner_uid', 'created_at', 'updated_at']);

      // Read: owner, collaborators, or public projects
      allow read: if isProjectOwner(projectId) ||
                     isProjectCollaborator(projectId) ||
                     isProjectPublic(projectId);

      // Update: only owner or collaborators
      allow update: if isProjectCollaborator(projectId) &&
                       (!('owner_uid' in request.resource.data.keys()) || 
                        request.resource.data.owner_uid == resource.data.owner_uid) &&
                       request.resource.data.updated_at > resource.data.updated_at;

      // Delete: only owner
      allow delete: if isProjectOwner(projectId);

      // Subcollection: tracks under projects
      match /tracks/{trackId} {
        allow read: if isProjectCollaborator(projectId) || isProjectPublic(projectId);
        allow create: if isProjectCollaborator(projectId) &&
                        request.resource.data.project_id == projectId &&
                        request.resource.data.created_by == request.auth.uid;
        allow update: if isProjectCollaborator(projectId);
        allow delete: if isProjectOwner(projectId) || 
                        (isAuthenticated() && resource.data.created_by == request.auth.uid);
      }

      // Subcollection: messages (chat) under projects
      match /messages/{messageId} {
        allow read: if isProjectCollaborator(projectId);
        allow create: if isProjectCollaborator(projectId) &&
                        request.resource.data.project_id == projectId &&
                        request.resource.data.sender_uid == request.auth.uid &&
                        request.resource.data.created_at > now - duration.value(1, 's');
        allow update: if isProjectCollaborator(projectId) &&
                        (resource.data.sender_uid == request.auth.uid) &&
                        request.resource.data.sender_uid == resource.data.sender_uid;
        allow delete: if isProjectCollaborator(projectId) &&
                        (resource.data.sender_uid == request.auth.uid ||
                         isProjectOwner(projectId));
      }
    }

    // ==================== Tracks Collection (Root Level) ====================
    match /tracks/{trackId} {
      allow read: if isAuthenticated() && 
                     isProjectCollaborator(resource.data.project_id);
      allow create: if isAuthenticated() &&
                       request.resource.data.created_by == request.auth.uid &&
                       request.resource.data.keys().hasAll(['project_id', 'title', 'created_by']);
      allow update: if isAuthenticated() &&
                       resource.data.created_by == request.auth.uid;
      allow delete: if isAuthenticated() &&
                       resource.data.created_by == request.auth.uid;
    }

    // ==================== Messages Collection (Root Level) ====================
    match /messages/{messageId} {
      allow read: if isAuthenticated() && 
                     isProjectCollaborator(resource.data.project_id);
      allow create: if isAuthenticated() &&
                       request.resource.data.sender_uid == request.auth.uid &&
                       isProjectCollaborator(request.resource.data.project_id);
      allow update: if isAuthenticated() &&
                       request.auth.uid == resource.data.sender_uid;
      allow delete: if isAuthenticated() &&
                       (request.auth.uid == resource.data.sender_uid ||
                        isProjectOwner(resource.data.project_id));
    }

    // ==================== Favorites Collection ====================
    match /favorites/{favoriteId} {
      allow read: if isAuthenticated() &&
                     (request.auth.uid == resource.data.user_uid ||
                      isProjectCollaborator(resource.data.project_id));
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.user_uid &&
                       isProjectCollaborator(request.resource.data.project_id);
      allow update: if isAuthenticated() &&
                       request.auth.uid == resource.data.user_uid;
      allow delete: if isAuthenticated() &&
                       request.auth.uid == resource.data.user_uid;

      // Validate rating field
      allow write: if !('rating' in request.resource.data) ||
                      (request.resource.data.rating >= 0 && request.resource.data.rating <= 5);
    }

    // ==================== Settings Collection ====================
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.user_uid;
      allow update: if isAuthenticated() &&
                       request.auth.uid == resource.data.user_uid;
      allow delete: if isAuthenticated() &&
                       request.auth.uid == resource.data.user_uid;

      // Validate theme and language values
      allow write: if !('theme_mode' in request.resource.data) || 
                      request.resource.data.theme_mode in ['light', 'dark', 'auto'] &&
                      !('privacy_level' in request.resource.data) ||
                      request.resource.data.privacy_level in ['private', 'friends', 'public'];
    }
  }
}
